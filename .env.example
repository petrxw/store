# Copy to .env.local and fill in. Never commit real values.

# Public site URL (no trailing slash). Used for Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (or swap src/lib/payments.ts for another approved provider)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="NEXORA <orders@your-domain.com>"

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CODE_ENCRYPTION_KEY=

# Automated delivery stays OFF until every product's source and resale
# authorization is verified. Also set delivery_verified = true per product.
AUTO_DELIVERY_ENABLED=false

# Checkout stays closed (browse-only store) until this is "true".
# Turn it on only after payment approval, verified products and a test purchase.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
